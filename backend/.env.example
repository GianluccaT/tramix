# Copiar este archivo como .env (en la carpeta backend) y completar con los datos de tu base.
# El .env no se sube al repo. En Render estas mismas variables se cargan en Environment.

# --- Local (MySQL instalado en tu compu) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_local
DB_NAME=tramix
DB_SSL=false

# --- Nube (TiDB Cloud Starter), los datos salen del botón "Connect" de TiDB ---
# DB_HOST=gateway01.xx-xxxx-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxx.root
# DB_PASSWORD=la_que_genera_tidb
# DB_NAME=tramix
# DB_SSL=true

# PORT no hace falta: en local se usa 3000 y en Render lo pone la plataforma
